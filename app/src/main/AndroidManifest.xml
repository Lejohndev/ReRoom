<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Revroom">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Revroom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".features.history.ui.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Revroom"
            android:label="My Projects" />

        <activity
            android:name=".features.history.ui.ProjectDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Revroom.Legacy"
            android:label="Project Details" />

        <activity
            android:name=".features.history.ui.ResultActivity"
            android:exported="false"
            android:theme="@style/Theme.Revroom.Legacy"
            android:label="Design Preview" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
